# SMS OTP provider (Twilio Verify) — legacy fallback for the mobile-number
# login at /login (app/api/auth/otp/*).
#
# Create a Verify Service in the Twilio console, then set:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# These are read server-side only (app/api/auth/otp/*) and are never sent
# to the browser. If unset, /login will show "SMS service isn't configured
# yet" instead of sending any code.

# --- Customer-service booking backend (deployed API) ---
# Primary API base. For local dev the frontend runs on :3000, so run the
# NestJS backend on :3001 (PORT=3001 npm run start:dev) and use:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Optional second backend, tried only when the primary is unreachable at the
# network level (connection refused/timed out — never on HTTP errors).
# NEXT_PUBLIC_API_FALLBACK_URL=http://<EC2-IP>:3000/api

# --- Deploy (this PC only — values live in git-ignored .env.local) ---
# deploy/deploy-site.ps1 reads these from .env.local; they must never be
# committed. The file itself is never uploaded to the server either.
# DEPLOY_PUBLIC_IP=<EC2-IP>
# DEPLOY_SSH_KEY=C:\path\to\key.pem

# --- Firebase web config ---
# Used for phone-OTP login; the Firebase ID token is exchanged at
# POST /auth/verify-otp for the backend JWT. Real values live in .env.local;
# lib/booking/firebase-client.ts has no built-in fallback.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase phone login: test mode (see .env.local) ---
# NEXT_PUBLIC_FIREBASE_TEST_MODE=true enables Firebase's official testing
# mechanism (dev builds only): no reCAPTCHA, no SMS. The number must ALSO be
# whitelisted in console → Authentication → Sign-in method → Phone →
# "Phone numbers for testing" with a fixed code.
# NEXT_PUBLIC_FIREBASE_TEST_MODE=

# --- Razorpay (customer-service payments) ---
# Public key matching the backend account behind POST /payments/razorpay/order.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
