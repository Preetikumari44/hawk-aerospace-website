# SMS OTP provider (Twilio Verify) — required for the mobile-number login
# at /login to send/verify real OTP text messages.
#
# Create a Verify Service in the Twilio console, then set:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# These are read server-side only (app/api/auth/otp/*) and are never sent
# to the browser. If unset, /login will show "SMS service isn't configured
# yet" instead of sending any code.

# Project Site map basemap (optional). Defaults to OpenStreetMap's public
# standard tiles, which need no key. To use another XYZ tile provider, set
# both — the attribution text is shown on the map and must match the
# provider's licence. Never put secrets in NEXT_PUBLIC_* values unless the
# provider issues browser-safe keys.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Optional. Leave empty so the login page calls /api/auth/otp/* on the same
# origin it is served from. Set only if the Next.js server runs on another
# origin/port, e.g. NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------------------
# Backends (SERVER-SIDE ONLY, read at request time; never use NEXT_PUBLIC_ for these).
# The browser posts to same-origin routes (/api/contact, /api/career/applications, /api/distributor/applications);
# those routes forward to the Java Spring Boot services below. No trailing slash.
# Point these at the locally started Spring Boot services (ports must match the backends' SERVER_PORT / PORT).
# scripts\start-frontend.ps1 sets them for you from the root .env; use this block only if you run `npm run dev` yourself:
CONTACT_API_URL=http://localhost:8081
CAREER_API_URL=http://localhost:8082
DISTRIBUTOR_API_URL=http://localhost:8083
# If a variable is empty the matching form reports "temporarily unavailable" (HTTP 503) - never a fake success.

# ---------------------------------------------------------------------------
# Applications launcher (/applications)
# Launch URL of the AgriSure application (http/https). The project has no AgriSure route of its own, so when this is
# empty the AgriSure card shows an "unavailable" state instead of a link. Read at request time (no rebuild needed).
AGRISURE_URL=

# ---------------------------------------------------------------------------
# Contact Us (/contact) - FRONTEND ONLY for now.
# Leave empty: the form validates but sends nothing and tells the visitor it is not connected yet (no fake success).
# When the Contact backend exists, set its base URL (no trailing slash); the form will POST to {base}/api/v1/contact.
# NEXT_PUBLIC_ values are baked in at build time. Never put secrets here.
NEXT_PUBLIC_CONTACT_API_BASE_URL=

# ---------------------------------------------------------------------------
# NestJS backend (login/OTP, bookings, My Bookings, tracking, roles). SERVER-SIDE ONLY, no trailing slash.
# The website reaches it through /api/* proxy routes. Unset -> those features report "not configured" (HTTP 503).
SUPERAPP_API_URL=http://localhost:3001

# ---- NestJS backend URL (client-side, baked at build time) ----
# Set this before `npm run build` so the browser calls the right backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
# Optional fallback (network-failure only, never on HTTP errors):
# NEXT_PUBLIC_API_FALLBACK_URL=

