# Copy to .env (never commit .env). Docker Compose reads it automatically. Replace every CHANGE_ME.
# Avoid the characters  $  "  '  #  and spaces in passwords (Compose / MySQL init interpolate them).

# ---- MySQL (one server, three separate databases + users) ----
MYSQL_ROOT_PASSWORD=CHANGE_ME_root
CONTACT_DB_PASSWORD=CHANGE_ME_contact
CAREER_DB_PASSWORD=CHANGE_ME_career
DISTRIBUTOR_DB_PASSWORD=CHANGE_ME_distributor
MYSQL_HOST_PORT=3307

# ---- Host ports ----
FRONTEND_HOST_PORT=3000
CONTACT_HOST_PORT=8081
CAREER_HOST_PORT=8082
DISTRIBUTOR_HOST_PORT=8083

# ---- Public origin of the website (CORS allow-list of the three backends). Production: https://your-domain ----
PUBLIC_SITE_ORIGIN=http://localhost:3000

# ---- SMTP (real-time Gmail delivery) ----
# Run scripts/configure-gmail.ps1 to enter the Google App Password securely and restart the APIs.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USERNAME=preetikumari3224@gmail.com
SMTP_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD
SMTP_SSL=false
SMTP_STARTTLS=true
# Sender. With Gmail this must be the authenticated account (Gmail rewrites any other From address).
MAIL_FROM=preetikumari3224@gmail.com
# Who receives the company notification e-mail for each form (default: the same inbox for all three).
# The applicant confirmation always goes to the address typed into the form, never to these.
CONTACT_NOTIFICATION_EMAIL=preetikumari3224@gmail.com
CAREER_NOTIFICATION_EMAIL=preetikumari3224@gmail.com
DISTRIBUTOR_NOTIFICATION_EMAIL=preetikumari3224@gmail.com

# ---- Distributor admin API (HTTP Basic). Leave the hash empty to keep the admin API disabled. ----
# A bcrypt hash contains "$" which Compose interpolates: write each "$" as "$$" here.
DISTRIBUTOR_ADMIN_USERNAME=admin
DISTRIBUTOR_ADMIN_PASSWORD_HASH=

# ---- Optional features of the main website ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
AGRISURE_URL=
