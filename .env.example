# SMS OTP provider (Twilio Verify) — required for the mobile-number login
# at /login to send/verify real OTP text messages.
#
# Create a Verify Service in the Twilio console, then set:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# These are read server-side only (app/api/auth/otp/*) and are never sent
# to the browser. If unset, /login will show "SMS service isn't configured
# yet" instead of sending any code.
