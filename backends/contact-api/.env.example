# Only needed when running this service WITHOUT Docker Compose (copy to .env in this folder; Spring reads it
# when started from here). With Docker Compose these values come from the root .env instead. NEVER commit .env.
DB_URL=jdbc:mysql://localhost:3306/hawk_contact?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=hawk_contact
DB_PASSWORD=CHANGE_ME
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_SSL=true
SMTP_STARTTLS=false
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Website Contact Form
MAIL_RECIPIENT=contact-inbox@example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
SERVER_PORT=8080
TRUST_FORWARDED_HEADERS=false
