# Copy to .env (never commit .env). Used by:
#   * docker compose  (MYSQL_*, DB_USERNAME, DB_PASSWORD)
#   * the Spring Boot backend when started from this folder (it reads ./.env automatically)
# Write values WITHOUT quotes. Do not put a bcrypt admin hash in this file (its "$" characters are
# interpreted by Docker Compose); set ADMIN_PASSWORD_HASH as an environment variable instead (see README).
# All values below are throw-away LOCAL examples. Replace every "change-me".

# ---- MySQL (docker compose) ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=hawk_distributor
MYSQL_HOST_PORT=3306

# ---- MySQL (backend connection; same user/password the container creates) ----
# Production: use a managed/secured MySQL and add &sslMode=VERIFY_IDENTITY (or at least REQUIRED).
DB_URL=jdbc:mysql://localhost:3306/hawk_distributor?connectionTimeZone=UTC&allowPublicKeyRetrieval=true&sslMode=PREFERRED
DB_USERNAME=hawk_app
DB_PASSWORD=change-me-app

# ---- SMTP (admin notification e-mail). Use an app password / secret manager in production ----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=smtp-user@example.com
MAIL_PASSWORD=change-me-smtp
MAIL_FROM=no-reply@example.com
ADMIN_NOTIFICATION_EMAIL=distributors@example.com
# Port 465 (implicit TLS): MAIL_SSL_ENABLED=true, MAIL_STARTTLS_ENABLED=false, MAIL_STARTTLS_REQUIRED=false
# Local Mailpit sink: MAIL_HOST=localhost MAIL_PORT=1025 MAIL_SMTP_AUTH=false MAIL_STARTTLS_ENABLED=false MAIL_STARTTLS_REQUIRED=false
#MAIL_SMTP_AUTH=true
#MAIL_STARTTLS_ENABLED=true
#MAIL_STARTTLS_REQUIRED=true
#MAIL_SSL_ENABLED=false

# ---- Frontend origin(s) allowed by CORS (exact, comma separated, no wildcard, no trailing slash) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Private document storage (absolute path, outside any web root; created on startup) ----
# Windows example: C:/hawk-distributor/uploads      Linux example: /var/lib/hawk-distributor/uploads
STORAGE_ROOT=./uploads

# ---- Admin API (HTTP Basic). Empty hash = admin API disabled. Set ADMIN_PASSWORD_HASH as an env var, not here ----
ADMIN_USERNAME=admin

# ---- Optional ----
SERVER_PORT=8080
SWAGGER_ENABLED=false
FORWARD_HEADERS_STRATEGY=none
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600
