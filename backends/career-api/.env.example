# Copy to .env (never commit .env) or export these in your process manager.
# Spring Boot does not read .env files by itself: use `set -a; . ./.env; set +a` or your platform's secret store.

# --- Server ---
PORT=8080
# Comma-separated origins allowed to call the API from a browser (the Next.js app normally calls it server-side)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- MySQL (existing database containing the drone_applications table) ---
DB_URL=jdbc:mysql://DB_HOST:3306/DB_NAME?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# --- File storage (must be OUTSIDE any publicly served directory) ---
STORAGE_ROOT=/var/lib/hawk-career/uploads
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=12MB
# Set true to make licenceFile mandatory when hasLicense=yes (the original PHP accepted it as optional)
REQUIRE_LICENSE_FILE=false

# --- SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_AUTH=true
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# Implicit TLS (port 465): SMTP_SSL=true SMTP_STARTTLS=false.  STARTTLS (port 587): SMTP_SSL=false SMTP_STARTTLS=true
SMTP_SSL=true
SMTP_STARTTLS=false
MAIL_FROM=careers@example.com
MAIL_FROM_NAME=Hawk Aero Careers
ADMIN_NOTIFICATION_EMAIL=admin@example.com
