# HAWK Frontend Environment Configuration
# Copy this file to .env.local and fill in your actual values
# .env.local is gitignored and will not be committed

# Backend API Configuration
# Main API URL (used for web, can be overridden per platform)
REACT_APP_API_URL=http://localhost:3001/api

# Platform-specific API URLs (optional, falls back to REACT_APP_API_URL)
# Android emulator needs 10.0.2.2 to reach host machine
REACT_APP_API_URL_ANDROID=http://10.0.2.2:3001/api
# iOS simulator uses localhost
REACT_APP_API_URL_IOS=http://localhost:3001/api

REACT_APP_API_BASE_URL=http://localhost:3001

# WebSocket Configuration
REACT_APP_WS_URL=ws://localhost:3001/ws

# Development Configuration
REACT_APP_ENV=development
REACT_APP_DEBUG=true

# Firebase Configuration (for client-side Firebase if needed)
REACT_APP_FIREBASE_PROJECT_ID=your-firebase-project-id
REACT_APP_FIREBASE_API_KEY=your-web-api-key-here

# App Configuration
REACT_APP_NAME=HAWK Admin App
REACT_APP_VERSION=1.0.0

# Feature Flags
REACT_APP_ENABLE_DEV_TOOLS=true
REACT_APP_ENABLE_ANALYTICS=false

# Google Maps Configuration
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Production Configuration
# For production, set these environment variables:
# - REACT_APP_API_URL (required)
# - REACT_APP_WS_URL (required)
# - REACT_APP_GOOGLE_MAPS_API_KEY (required for maps)
# - REACT_APP_FIREBASE_PROJECT_ID (if using Firebase)
