{
  "name": "HawkAdminCLI",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "build": "webpack --mode production --config webpack.config.js",
    "build:android": "cd android && gradlew assembleRelease",
    "build:android:prod": "powershell -ExecutionPolicy Bypass -File build-apk.ps1",
    "build:ios": "cd ios && xcodebuild -workspace HawkAdminCLI.xcworkspace -scheme HawkAdminCLI -configuration Release",
    "web": "webpack serve --mode development --config webpack.config.js",
    "web:debug": "node debug-bundle.js",
    "web:clean": "rm -rf dist node_modules/.cache"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native/new-app-screen": "0.86.0",
    "@react-navigation/drawer": "^7.12.2",
    "@react-navigation/native": "^7.3.4",
    "@react-navigation/native-stack": "^7.17.5",
    "@react-navigation/stack": "^7.10.5",
    "react": "19.2.7",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-reanimated": "^4.4.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "^15.15.5",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.10.0",
    "react-native-worklets-core": "^1.6.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/plugin-transform-modules-commonjs": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.25.7",
    "@babel/preset-typescript": "^7.25.7",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@svgr/webpack": "^8.1.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "ajv": "^8.20.0",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "dotenv": "^17.4.2",
    "eslint": "^8.19.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.7",
    "style-loader": "^4.0.0",
    "typescript": "^5.8.3",
