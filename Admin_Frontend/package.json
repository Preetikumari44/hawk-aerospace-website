    "browserslist": "^4.28.7",
    "decode-uri-component": "^0.5.0",
    "fast-uri": "^3.1.5",
    "fast-xml-parser": "^5.7.0",
    "joi": "^17.13.6",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "qs": "^6.16.0",
    "socket.io-parser": "^4.2.7",
    "svgo": "^3.3.4",
    "uuid": "^11.1.1"
  }
