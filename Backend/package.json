{
  "name": "hawk-super-app-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS Phase 1 foundation for the Hawk Aerosystem Super App backend.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings=0 --no-error-on-unmatched-pattern",
    "format": "prettier --check \"src/**/*.ts\" --ignore-unknown",
    "test": "jest --passWithNoTests --runInBand",
    "test:watch": "jest --watch --passWithNoTests --runInBand",
    "test:cov": "jest --coverage --passWithNoTests --runInBand",
    "test:unit": "jest --testPathPattern=\\.spec\\.ts$ --passWithNoTests --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests --runInBand",
    "test:integration": "jest --testPathPattern=e2e-spec --passWithNoTests --runInBand",
    "test:performance": "jest --testPathPattern=performance --passWithNoTests --runInBand",
    "test:functional": "jest --testPathPattern=functional --passWithNoTests --runInBand",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:functional && npm run test:performance",
    "test:ci": "jest --ci --coverage --maxWorkers=2 --passWithNoTests",
    "env:generate": "node scripts/generate-secrets.js",
    "env:generate:update": "node scripts/generate-secrets.js --update",
    "env:validate": "node scripts/validate-env.js",
    "env:setup": "npm run env:generate:update && npm run env:validate",
    "firebase:migrate": "node scripts/firebase/migration-runner.js",
    "firebase:seed:superadmin": "node scripts/firebase/seed-superadmin.js",
    "firebase:seed:customers": "node scripts/firebase/seed-customers.js",
    "firebase:seed:customers-firebase": "node scripts/database/seed-customers-firebase.js",
    "firebase:seed:customers-direct": "node scripts/database/seed-customers-direct.js",
    "firebase:seed": "npm run firebase:migrate && npm run firebase:seed:superadmin && npm run firebase:seed:customers-firebase",
    "firebase:setup": "npm run firebase:seed"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@nestjs/common": "^10.4.12",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.12",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.12",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.22",
    "@sendgrid/mail": "^8.1.6",
    "@upstash/redis": "^1.38.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.2.0",
    "isomorphic-dompurify": "^3.18.0",
    "mongodb": "^7.3.0",
    "mongoose": "^8.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.12",
    "@types/express": "^5.0.1",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
    "overrides": {
    "ajv": "^8.18.0",
    "baseline-browser-mapping": "^2.11.0",
    "body-parser": "^1.20.6",
    "brace-expansion": "^2.1.4",
    "browserslist": "^4.28.7",
    "decode-uri-component": "^0.5.0",
    "dompurify": "^3.4.13",
    "fast-xml-parser": "^5.10.1",
    "file-type": "^21.3.2",
    "glob": "^10.5.0",
    "js-yaml": "^4.3.1",
    "lodash": "^4.18.1",
    "multer": "^2.2.0",
    "picomatch": "^4.0.4",
    "protobufjs": "^7.6.5",
    "qs": "^6.16.0",
    "socket.io-parser": "^4.2.7",
    "tmp": "^0.2.6",
    "undici": "^7.29.0",
    "uuid": "^11.1.1",
    "webpack": "^5.104.1"
  }
  
}
