NODE_ENV=development
PORT=3001
API_PREFIX=api

# Database Configuration
# Set to 'false' to disable MongoDB connection (useful when server is down)
MONGODB_ENABLED=true
MONGODB_URI=mongodb://127.0.0.1:27017/hawk-backend
MONGODB_DB_NAME=hawk-backend

# JWT Configuration
# CRITICAL: These secrets must be changed in production!
# Generate secure secrets with: openssl rand -base64 64
# 
# SECURITY REQUIREMENTS:
# - Minimum 32 characters
# - Must be cryptographically random
# - Must NOT contain well-known values (secret, changeme, etc.)
# - Must be unique per environment
# - Must be kept confidential
#
# The application will:
# - Auto-generate secrets in development/test if not provided
# - FAIL TO START in production if secrets are missing or weak
# - Validate secrets meet security requirements on startup
#
JWT_SECRET=replace-with-long-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Development OTP Configuration (disable in production)
# Only the phone numbers in AUTH_DEV_OTP_PHONES get the fixed OTP code.
# All other numbers MUST go through real Firebase SMS verification.
AUTH_DEV_OTP_ENABLED=true
AUTH_DEV_OTP_CODE=123456
# Comma-separated list of test phone numbers that get the fixed OTP code (e.g. +911234567890)
AUTH_DEV_OTP_PHONES=

# Firebase Configuration
FIREBASE_PROJECT_ID=aerosystem-2d36c
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"
# Required when using a named Firestore database instead of default
FIREBASE_DATABASE_ID=
# Firebase Storage Bucket - used for all file uploads (KYC, documents, media, etc.)
# MUST match EXACTLY what Firebase Console > Storage shows (without gs://).
# New projects (Oct 2024+): <project-id>.firebasestorage.app
# Old projects: <project-id>.appspot.com
FIREBASE_STORAGE_BUCKET=aerosystem-2d36c.firebasestorage.app

# Firestore Sync Configuration
# Set to 'true' to enable automatic Firestore to MongoDB synchronization
FIRESTORE_SYNC_ENABLED=false

# Booking Expiry Sweep Configuration
# Hourly cron that system auto-cancels bookings whose service date has fully
# passed (23:59:59 IST) without approval/assignment/start/completion, with a
# FULL (100%) refund when an amount is due. Set to 'false' to pause the job.
BOOKING_EXPIRY_ENABLED=true

# Database Source Configuration
# Set to 'mongodb' to query MongoDB Atlas directly (recommended)
# Set to 'firestore' to query Firestore
DATABASE_SOURCE=mongodb

# CORS Configuration
# Comma-separated list of allowed origins for HTTP and WebSocket connections
# Example: http://localhost:3000,http://localhost:3001,https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# Proxy Configuration
# TRUST_PROXY: Set to 'true' if the application is behind a reverse proxy (nginx, load balancer, etc.)
# This is essential for correctly extracting client IP addresses from proxy headers
# Default: true (automatically enabled in main.ts)
# Note: The application automatically trusts the first proxy. For multiple proxies, 
# you may need to adjust the trust proxy configuration in main.ts based on your infrastructure.

# Rate Limiting Configuration
# Global rate limit: maximum requests per time window (in ms)
# THROTTLE_TTL is the time window in milliseconds
# THROTTLE_LIMIT is the maximum number of requests allowed in that window
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Auth-specific rate limiting (applies to auth endpoints only)
# AUTH_RATE_LIMIT_MAX_REQUESTS: Maximum auth attempts per window (default: 10)
# AUTH_RATE_LIMIT_WINDOW_MS: Time window in milliseconds (default: 60000 = 1 minute)
# Rate limiting uses composite keys: IP address + User-Agent fingerprint
# This prevents bypassing limits by rotating IPs or User-Agents alone
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# WebSocket Configuration
# Maximum concurrent WebSocket connections per user (default: 5)
WS_MAX_CONNECTIONS_PER_USER=5

# WebSocket message and timing configuration
# WS_MAX_BUFFER_SIZE: Maximum message size in bytes (default: 1000000 = 1MB)
WS_MAX_BUFFER_SIZE=1000000

# WebSocket Timeouts (in milliseconds)
# WS_PING_TIMEOUT: How long to wait for pong response (default: 60000ms = 60s)
# WS_PING_INTERVAL: How often to send ping to client (default: 25000ms = 25s)
WS_PING_TIMEOUT=60000
WS_PING_INTERVAL=25000

# API Keys (add as needed)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Flight Conditions (weather + airspace pre-flight checks)
# Weather: defaults to Open-Meteo (free, no key). Override only to use another provider.
# WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# Airspace: if unset, uses built-in geofence dataset + Firestore `airspace_zones`.
#           Set to delegate to a real provider (e.g. DGCA Digital Sky) returning
#           { status: GREEN|YELLOW|RED, zones?: [], reasons?: [] }.
# AIRSPACE_API_URL=https://your-airspace-provider.example/check
# =============================================================================
# Notification Configuration (Multi-Channel)
# =============================================================================
# Current: IN_APP (Firestore) + WebSocket only
# Target: PUSH (FCM) + SMS (Twilio/MSG91) + EMAIL (SendGrid)
# See: Backend/srs_images/NOTIFICATION_ARCHITECTURE_INDUSTRY_STANDARD.md

# Notification Features
NOTIFICATION_RETRY_ENABLED=true
NOTIFICATION_RATE_LIMITING_ENABLED=true
NOTIFICATION_BATCH_ENABLED=false
NOTIFICATION_BATCH_INTERVAL_MS=300000

# OTP goes via Firebase Auth SDK (no SMS provider needed for OTP).
# Referral invites go via on-device Share (free) + FCM + WhatsApp Cloud API below.
# Twilio is NOT used. Leave TWILIO_* unset.
# SMS_PROVIDER=none

# SMS - MSG91 (India-focused, cheaper)
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_SENDER_ID=HAWKAE
# MSG91_FLOW_ID=your_flow_id

# Email Provider: 'sendgrid' (recommended) or 'aws-ses'
EMAIL_PROVIDER=sendgrid

# Email - SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@hawkaero.com
SENDGRID_FROM_NAME=Hawk Aerosystem

# WhatsApp Cloud API (Meta) — forever-free 1,000 service conversations/month.
# Setup: developers.facebook.com → Create App → Add WhatsApp product →
# copy Phone Number ID + token → create template hawk_referral_invite →
# Business Settings → System User → permanent token.
# WHATSAPP_TOKEN=your-permanent-whatsapp-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_TEMPLATE_NAME=hawk_referral_invite
# WHATSAPP_TEMPLATE_LANG=en

# Refer & Earn — currently served from the EC2 web build (no domain yet).
# When hawkaerosystem.com is live, switch both to https://hawkaerosystem.com[/r].
# REFERRAL_LINK_BASE=http://43.205.190.95:8081/r
# PUBLIC_API_BASE=http://43.205.190.95:3000
# REFERRAL_CODE_TTL_DAYS=60
# REFERRAL_MIN_WITHDRAWAL=100
# REFERRAL_WITHDRAW_HOLD_DAYS=7
# REFERRAL_MAX_INVITES_PER_DAY=20

# FCM (Firebase Cloud Messaging) - uses Firebase Admin config above
# No additional configuration needed

# --- Payment gateway (India, UPI). Required for online payments. ---
# Test mode keys: Razorpay Dashboard → Settings → API Keys → Generate Test Key
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# RazorpayX (payouts / auto-withdraw): RazorpayX Dashboard → Settings → Account numbers
# This is the SOURCE account money is paid OUT from (looks like acc_... or a virtual account number).
# RAZORPAY_ACCOUNT_NUMBER=acc_xxxxxxxxxxxxxx
# Optional: for webhook signature validation (Dashboard → Settings → Webhooks)
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# STRIPE_SECRET_KEY=your-stripe-secret-key

# File Storage Configuration
# All files including KYC documents (identity proofs, licenses) are stored in Firebase Storage
# Storage Bucket: gs://hawk-f4b04.firebasestorage.app
# Bucket Structure:
#   - profile-images/     → User profile photos
#   - documents/          → KYC docs, licenses, certificates, GST
#   - booking-media/      → Before/after photos, drone footage, reports
#   - maintenance-media/  → Repair photos, diagnosis reports
#   - general/            → Misc uploads
# Upload Flow: Client → Request signed URL → Upload directly to Firebase → Register metadata
# File metadata is stored in Firestore collection: file_metadata
# CDN URLs are generated for public file access

# Upstash Redis Cache Configuration (optional - falls back to in-memory cache if not provided)
# Get your credentials from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here
