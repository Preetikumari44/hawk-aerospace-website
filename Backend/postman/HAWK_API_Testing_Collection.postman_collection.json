            "url": {
              "raw": "{{baseUrl}}/pilot-applications/{{applicationId}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["pilot-applications", "{{applicationId}}", "review"]
            },
            "description": "Admin: Reject application with reason. User remains as customer and can reapply after fixing issues."
          }
        }
