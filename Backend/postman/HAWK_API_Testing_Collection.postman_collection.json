    {
      "name": "7. Pilot Application - Customer Flow",
      "item": [
        {
          "name": "7.1 Request Document Upload URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('uploadUrl', response.uploadUrl);",
                  "    pm.collectionVariables.set('storagePath', response.storagePath);",
                  "    console.log('✓ Upload URL generated');",
                  "    console.log('Storage Path:', response.storagePath);",
                  "    console.log('Now upload the file directly to Firebase Storage using the uploadUrl');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"aadhaar_front.jpg\",\n  \"contentType\": \"image/jpeg\",\n  \"fileSize\": 245760,\n  \"bucket\": \"documents\",\n  \"folder\": \"kyc/aadhaar_front\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/files/upload-url",
              "host": ["{{baseUrl}}"],
              "path": ["files", "upload-url"]
            },
            "description": "Step 1: Request a signed upload URL for document upload. Client will upload directly to Firebase Storage using this URL."
          }
        },
        {
          "name": "7.2 Register Uploaded Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('downloadUrl', response.downloadUrl);",
                  "    console.log('✓ Document registered');",
                  "    console.log('Download URL:', response.downloadUrl);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"aadhaar_front.jpg\",\n  \"contentType\": \"image/jpeg\",\n  \"fileSize\": 245760,\n  \"storagePath\": \"{{storagePath}}\",\n  \"downloadUrl\": \"https://storage.googleapis.com/your-bucket/path/to/file.jpg\",\n  \"category\": \"kyc\",\n  \"documentType\": \"aadhaar\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/files/register",
              "host": ["{{baseUrl}}"],
              "path": ["files", "register"]
            },
            "description": "Step 3: Register file metadata after client uploads file directly to Firebase Storage. Update downloadUrl with actual URL from Firebase."
          }
        },
        {
          "name": "7.3 Submit Pilot Application",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('applicationId', response.applicationId);",
                  "    console.log('✓ Application submitted successfully');",
                  "    console.log('Application ID:', response.applicationId);",
                  "    console.log('Status:', response.status);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ramesh Patil\",\n  \"age\": 41,\n  \"phone\": \"+919220989863\",\n  \"email\": \"ramesh.patil@example.com\",\n  \"address\": \"Pune, Maharashtra\",\n  \"pilotLicenseNumber\": \"DGCA-MA-2022-444633\",\n  \"pilotExpiryDate\": \"2033-01-04T00:00:00.000Z\",\n  \"aadhaarCardNumber\": \"2925 4862 8296\",\n  \"panNumber\": \"PALGI5465N\",\n  \"gstNumber\": \"27PALGI5465N1Z5\",\n  \"serviceTypes\": [\"spraying\", \"mapping\"],\n  \"specializations\": [\"Crop Spraying\", \"Monitoring\"],\n  \"flightHours\": 100,\n  \"experience\": 3,\n  \"documents\": [\n    {\n      \"type\": \"aadhaar_front\",\n      \"storagePath\": \"{{storagePath}}\",\n      \"downloadUrl\": \"{{downloadUrl}}\",\n      \"verified\": \"pending\"\n    },\n    {\n      \"type\": \"aadhaar_back\",\n      \"storagePath\": \"documents/uid/kyc/aadhaar_back/file.jpg\",\n      \"downloadUrl\": \"https://storage.googleapis.com/...\",\n      \"verified\": \"pending\"\n    },\n    {\n      \"type\": \"pilot_license\",\n      \"storagePath\": \"documents/uid/kyc/pilot_license/file.pdf\",\n      \"downloadUrl\": \"https://storage.googleapis.com/...\",\n      \"verified\": \"pending\"\n    },\n    {\n      \"type\": \"gst_registration\",\n      \"storagePath\": \"documents/uid/kyc/gst_registration/file.pdf\",\n      \"downloadUrl\": \"https://storage.googleapis.com/...\",\n      \"verified\": \"pending\"\n    }\n  ],\n  \"additionalNotes\": \"Experienced pilot with focus on agricultural operations\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pilot-applications/submit",
              "host": ["{{baseUrl}}"],
              "path": ["pilot-applications", "submit"]
            },
            "description": "Submit complete pilot application with all required documents. Customer must upload documents first via steps 7.1 and 7.2."
          }
        },
