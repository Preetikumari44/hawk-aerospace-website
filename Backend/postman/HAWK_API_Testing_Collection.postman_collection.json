              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"verified\",\n  \"notes\": \"Document is clear and valid. License verified with DGCA database.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pilot-applications/{{applicationId}}/documents/pilot_license/verify",
