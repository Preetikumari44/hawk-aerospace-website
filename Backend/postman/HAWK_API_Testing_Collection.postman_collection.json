            },
            "url": {
              "raw": "{{baseUrl}}/pilot-applications/{{applicationId}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["pilot-applications", "{{applicationId}}", "review"]
            },
            "description": "Admin: Approve application. This performs atomic transaction:\n1. Updates application status to 'approved'\n2. Creates pilot document with same UID as user\n3. Adds 'pilot' role to user's roles array\n\nOptional: Assign fleet manager during approval"
          }
        },
        {
          "name": "8.6 Reject Application",
          "request": {
            "method": "PATCH",
