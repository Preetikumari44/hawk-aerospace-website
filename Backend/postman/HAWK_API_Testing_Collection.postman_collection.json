    {
      "name": "8. Pilot Application - Admin Review",
      "item": [
        {
          "name": "8.1 Get All Applications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
