        {
          "name": "8.5 Approve Application",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    console.log('✓ Application approved successfully');",
                  "    console.log('Pilot UID:', response.pilot?.uid);",
                  "    console.log('User roles updated to:', response.pilot ? '[customer, pilot]' : 'N/A');",
                  "    console.log('Pilot document created in pilots collection');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
